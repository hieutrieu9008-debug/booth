# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS provider: simulated | twilio | telnyx (only simulated is implemented)
SMS_PROVIDER=simulated

# Cron auth (queue flush endpoint)
CRON_SECRET=

# Staff-session cookie signing secret (falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
STAFF_AUTH_SECRET=

# Public app URL — used to build member card links, auth redirects
NEXT_PUBLIC_APP_URL=

# Gate code for the /internal operator console. Any value works locally.
# /internal refuses to open if this is unset.
INTERNAL_ACCESS_CODE=

# Optional. Powers the AI program generator in /internal.
# Without it, the generator falls back to a manual draft path.
OPENAI_API_KEY=

# Provider adapters — set SMS_PROVIDER=twilio|telnyx and the matching creds
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_UK_BUNDLE_SID=   # approved UK RC bundle (created once in console per runbook)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=      # base64 Ed25519 webhook key from Mission Control
